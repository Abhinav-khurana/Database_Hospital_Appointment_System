{
  "name": "hospital-appointments",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:seed": "node database/02_seed.js",
    "db:provision": "node database/provision.js",
    "db:verify": "node database/verify.js",
    "db:demo": "node database/04_crud_demo.js",
    "db:analytics": "node database/05_analytics.js",
    "dev": "concurrently -k -n API,WEB \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "local": "node scripts/local.js",
    "demo:consultation": "node scripts/demo-consultation.js",
    "launch": "npm run setup && npm run build && npm run local"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongodb": "6.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "mongodb-memory-server": "10.2.1",
    "supertest": "7.1.4",
    "vite": "6.3.6",
    "esbuild": "0.25.12"
  }
}
